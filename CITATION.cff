        given-names: Elisabeth
      - family-names: "Holmstrøm"
        given-names: Henrik
      - family-names: "Möller"
        given-names: Thomas
    journal: "European Journal of Pediatrics"
    volume: 184
    issue: 7
    start: 450
    year: 2025
    doi: 10.1007/s00431-025-06270-x
